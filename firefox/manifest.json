{
  "manifest_version": 3,
  "name": "Okdesk Clearbat Launcher Firefox",
  "version": "1.3.0",
  "description": "Кнопки запуска iikoOffice/iikoChain и удаленного доступа (Ассистент/RustDesk/AnyDesk) на странице заявки Okdesk",
  "icons": {
    "16": "icons/okdesk-16.png",
    "32": "icons/okdesk-32.png",
    "48": "icons/okdesk-48.png",
    "128": "icons/okdesk-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://aqba.okdesk.ru/*",
        "https://help.aqba.ru/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*"
      ],
      "matches": [
        "https://aqba.okdesk.ru/*",
        "https://help.aqba.ru/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "okdesk-clearbat-launcher@ruffid.local",
      "strict_min_version": "109.0"
    }
  }
}
